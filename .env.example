# Public browser configuration. Supabase publishable keys are designed to be
# exposed to the frontend; authorization remains enforced by PostgreSQL RLS.
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_PUBLISHABLE_KEY=replace-with-supabase-publishable-key

# Local Google OAuth configuration. Never prefix provider secrets with VITE_.
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=
