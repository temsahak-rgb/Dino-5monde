{
  "name": "dino-5monde",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.tools.json --noEmit",
    "test": "tsx --test \"tests/**/*.test.ts\"",
    "test:app": "tsx --test \"tests/architecture/**/*.test.ts\" \"tests/grammar/**/*.test.ts\" \"tests/institutional/**/*.test.ts\" \"tests/navigation/**/*.test.ts\" \"tests/search/**/*.test.ts\" \"tests/tools/**/*.test.ts\" \"tests/vocabulary/**/*.test.ts\"",
    "test:data": "tsx --test \"tests/data/**/*.test.ts\"",
    "test:features": "npm run features:report && cucumber-js",
    "test:architecture": "tsx --test \"tests/architecture/**/*.test.ts\"",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:install": "playwright install chromium",
    "serve:e2e": "vite preview --host 127.0.0.1 --port 4173",
    "corpus:report": "tsx tools/build-corpus-report.ts",
    "features:report": "tsx tools/build-feature-report.ts --output reports/feature-progress.json --markdown reports/feature-progress.md",
    "vigie:report": "tsx tools/build-project-vigie.ts",
    "knip": "knip --config knip.json",
    "duplication": "jscpd --config .jscpd.json",
    "graph:dependencies": "tsx tools/generate-dependency-graph.ts",
    "graph:dependencies:check": "tsx tools/generate-dependency-graph.ts --check"
  },
  "dependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router": "^8.2.0"
  },
  "devDependencies": {
    "@cucumber/cucumber": "^13.2.1",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "jscpd": "^4.0.0",
    "knip": "^5.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vite": "^8.2.2"
  }
}
