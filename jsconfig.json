{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,

    "target": "ES2022",
    "lib": [
      "ES2022",
      "DOM"
    ],

    "moduleDetection": "legacy",

    "strict": false,
    "noImplicitAny": false,
    "skipLibCheck": true
  },

  "include": [
    "app.js",
    "src/**/*.js"
  ],

  "exclude": [
    "node_modules",
    "tools",
    "tests"
  ]
}